# ==============================================================================
# Autonomous AI Software Engineering Platform - Environment Configuration
# Safe local-development defaults. Duplicate as .env for custom local settings.
# ==============================================================================

# Application Environment (development | test | production)
NODE_ENV=development

# ------------------------------------------------------------------------------
# Frontend Application (apps/web)
# ------------------------------------------------------------------------------
VITE_API_URL=http://localhost:4000
VITE_PORT=5173

# ------------------------------------------------------------------------------
# Core API Service (services/api)
# ------------------------------------------------------------------------------
PORT=4000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info
REQUEST_TIMEOUT_MS=10000

# Comma-separated absolute directories that repository analysis may read, e.g.
# ALLOWED_REPO_ROOTS=/home/me/checkouts,/srv/repos
# No default: while empty, analysis requests return 503. Repository records
# must point to an absolute local path inside one of these roots.
ALLOWED_REPO_ROOTS=
# Separate writable task snapshot root; keep it outside authorized checkouts.
# Required for model-backed CODE_PATCH tasks.
TASK_WORKSPACE_ROOT=

# Isolated repository execution. Disabled by default. To enable in local
# development, run the worker on the host with Docker CLI/Engine access and build
# services/api/sandbox/Dockerfile locally. The application Compose worker does
# not receive the Docker socket and therefore cannot use this provider.
SANDBOX_PROVIDER=unavailable
SANDBOX_DOCKER_IMAGE=
SANDBOX_DOCKER_EXECUTABLE=docker
SANDBOX_DOCKER_UID=1000
SANDBOX_DOCKER_GID=1000
SANDBOX_COMMAND_TIMEOUT_MS=180000
SANDBOX_MEMORY_MB=1024
SANDBOX_CPU_COUNT=2
SANDBOX_MAX_PROCESSES=128
SANDBOX_MAX_OUTPUT_BYTES=262144
SANDBOX_WORKSPACE_SIZE_MB=256

# ------------------------------------------------------------------------------
# Authentication & Session Security (Phase 2)
# ------------------------------------------------------------------------------
# Development-only default secret. Production will reject this default.
JWT_SECRET=dev-jwt-insecure-secret-key-change-in-production-only
JWT_EXPIRES_IN=7d
COOKIE_SECRET=dev-cookie-secret-do-not-use-in-production
COOKIE_SECURE=false
# Optional development-only in-memory inbox for invitation and password-reset links (minimum 24 chars).
# This is not an email provider and must not be configured in production.
# DEV_MAILBOX_TOKEN=
AUTH_STATE_STORE=redis
# Shared Redis session and rate-limit state. `memory` is for isolated tests or
# local development only; production startup rejects that value.
AUTH_STATE_KEY_PREFIX=asea
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=5

# ------------------------------------------------------------------------------
# Background Processing & Outbox Dispatcher (Phase 2)
# ------------------------------------------------------------------------------
OUTBOX_POLL_INTERVAL_MS=3000
OUTBOX_BATCH_SIZE=20
BULLMQ_WORKER_CONCURRENCY=2

# ------------------------------------------------------------------------------
# Python AI Agent Service (services/agent-service)
# ------------------------------------------------------------------------------
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_PORT=8000
AI_SERVICE_HOST=0.0.0.0

# Shared secret: the worker sends it as X-Internal-Token and the agent service
# requires it on /api/v1/*. No default: while empty, /api/v1/* returns 503.
# Generate one, e.g.: python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_SERVICE_TOKEN=
# How long the worker waits for the agent service's static analysis (ms)
AI_SERVICE_TIMEOUT_MS=180000
# Largest VerificationRequest the worker sends; keep <= AGENT_MAX_REQUEST_BYTES
VERIFICATION_MAX_REQUEST_BYTES=5242880
# Maximum request body accepted by the agent service (bytes)
AGENT_MAX_REQUEST_BYTES=5242880

# Static analysis (POST /api/v1/verify/static); see services/agent-service/README.md
ASEA_AUTH_DECORATORS=login_required
SEMGREP_COMMAND=semgrep
SEMGREP_TIMEOUT_SECONDS=120
# Semgrep runs offline on the pinned ruleset fetched by `npm run semgrep:rules`;
# SEMGREP_RULESET / SEMGREP_RULES_LOCK default to services/agent-service/rules/semgrep/p-python(.lock).json

# LLM behind the negative-space, architecture and reporter agents.
# fake = deterministic stand-in, no key needed (tests, CI, local runs);
# anthropic = Claude via the Anthropic API (needs LLM_API_KEY; MODEL_NAME
# defaults to claude-opus-5-5). Without a usable LLM the agents are skipped and
# no verification can be allowed.
LLM_PROVIDER=anthropic
LLM_API_KEY=
MODEL_NAME=
LLM_EFFORT=high
LLM_TIMEOUT_SECONDS=120
# Independent patch review is disabled until a separate reviewer identity is
# configured. If REVIEW_LLM_PROVIDER matches LLM_PROVIDER, use a different model.
REVIEW_LLM_PROVIDER=
REVIEW_LLM_API_KEY=
REVIEW_MODEL_NAME=
# Per agent attempt, and attempts per agent (timeouts and failures are retried)
AGENT_TIMEOUT_SECONDS=240
AGENT_MAX_ATTEMPTS=2

# Repository index for the architecture agent (Qdrant from compose.yaml).
# Empty = in-memory index inside the agent service (lost on restart).
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
# What the worker sends to the index: Python files at the base commit
INDEX_MAX_FILES=5000
INDEX_MAX_BYTES=20971520
INDEX_BATCH_BYTES=2097152

# ------------------------------------------------------------------------------
# GitHub (pull request verification)
# ------------------------------------------------------------------------------
# Webhook secrets are per repository (generated in the UI / PUT .../github).
# Token that may comment on pull requests; empty = results are not posted.
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com
# GitHub App integration for installation, repository selection, PR publishing,
# and check synchronization. Configure all six values together; never expose
# the private key or webhook secret to the browser.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# PEM-encoded private key; literal \\n sequences are accepted in container env files.
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=
# Public URL of the web app: links in PR comments and the webhook URL shown
PUBLIC_WEB_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# PostgreSQL Infrastructure (Local Docker Compose)
# ------------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=autonomous_dev
POSTGRES_USER=dev_user
POSTGRES_PASSWORD=dev_password
# Set to 'true' if the API readiness endpoint must fail when Postgres is down
POSTGRES_REQUIRED_FOR_READINESS=false

# Full connection string format used by Prisma ORM
DATABASE_URL=postgresql://dev_user:dev_password@localhost:5432/autonomous_dev

# ------------------------------------------------------------------------------
# Redis Infrastructure (Local Docker Compose & BullMQ)
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
# Set to 'true' if the API readiness endpoint must fail when Redis is down
REDIS_REQUIRED_FOR_READINESS=false

# Full connection string format used by BullMQ
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# Legacy feature flags. The sandbox provider is configured through SANDBOX_*.
# ------------------------------------------------------------------------------
