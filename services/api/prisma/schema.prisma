datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

enum RepositoryProvider {
  LOCAL
  GITHUB
}

enum RepoConnectionStatus {
  CONNECTED
  DISCONNECTED
  PENDING
}

enum VerificationRunStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum AuthorType {
  AI
  HUMAN
  UNKNOWN
}

enum FindingCategory {
  STATIC
  NEGATIVE_SPACE
  ARCHITECTURE
  TEST_GAP
}

enum FindingSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum FindingSource {
  DETERMINISTIC
  LLM
}

enum TaskType {
  BUG_INVESTIGATION
  CODE_PATCH
  TEST_GENERATION
  CODE_REVIEW
  CI_DIAGNOSIS
  VERIFICATION
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum TaskStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCEL_REQUESTED
  CANCELLED
  NEEDS_ATTENTION
}

enum WorkflowRunStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum WorkflowStepType {
  VALIDATE_CONTEXT
  INSPECT_REPOSITORY
  GENERATE_SPEC
  VERIFY_BOUNDARIES
  SIMULATE_EXECUTION
  STATIC_ANALYSIS
}

enum WorkflowStepStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  SKIPPED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OutboxStatus {
  PENDING
  DISPATCHED
  FAILED
}

enum AnalysisStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

model User {
  id                 String                @id @default(uuid())
  email              String                @unique
  passwordHash       String
  displayName        String
  accountStatus      AccountStatus         @default(ACTIVE)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  ownedWorkspaces    Workspace[]           @relation("WorkspaceOwner")
  memberships        WorkspaceMembership[]
  tasks              Task[]                @relation("TaskCreator")
  approvalsRequested Approval[]            @relation("ApprovalRequester")
  approvalsDecided   Approval[]            @relation("ApprovalDecider")

  @@index([email])
}

model Workspace {
  id          String                @id @default(uuid())
  name        String
  ownerId     String
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  owner       User                  @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members     WorkspaceMembership[]
  repositories Repository[]
  tasks       Task[]
  auditEvents AuditEvent[]
  analyses    RepositoryAnalysis[]
  verificationRuns VerificationRun[]

  @@index([ownerId])
}

model WorkspaceMembership {
  id          String        @id @default(uuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime      @default(now())

  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@index([workspaceId])
}

model Repository {
  id               String               @id @default(uuid())
  workspaceId      String
  name             String
  provider         RepositoryProvider   @default(LOCAL)
  repositoryUrl    String
  defaultBranch    String               @default("main")
  connectionStatus RepoConnectionStatus @default(CONNECTED)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  workspace        Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tasks            Task[]
  analyses         RepositoryAnalysis[]
  verificationRuns VerificationRun[]

  @@index([workspaceId])
}

model Task {
  id                String         @id @default(uuid())
  workspaceId       String
  repositoryId      String?
  creatorId         String
  title             String
  description       String
  taskType          TaskType       @default(BUG_INVESTIGATION)
  status            TaskStatus     @default(QUEUED)
  priority          TaskPriority   @default(NORMAL)
  repositoryUrl     String?
  targetBranch      String         @default("main")
  idempotencyKey    String?
  startedAt         DateTime?
  completedAt       DateTime?
  failureCode       String?
  failureReason     String?
  executionMetadata Json?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  workspace         Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  repository        Repository?    @relation(fields: [repositoryId], references: [id], onDelete: SetNull)
  creator           User           @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  runs              WorkflowRun[]
  verificationRuns  VerificationRun[]
  approvals         Approval[]

  @@index([workspaceId])
  @@index([status])
  @@index([creatorId])
  @@index([idempotencyKey])
}

model WorkflowRun {
  id             String            @id @default(uuid())
  taskId         String
  attemptNumber  Int               @default(1)
  status         WorkflowRunStatus @default(QUEUED)
  workerId       String?
  startedAt      DateTime?
  finishedAt     DateTime?
  errorSummary   String?
  configMetadata Json?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  task           Task              @relation(fields: [taskId], references: [id], onDelete: Cascade)
  steps          WorkflowStep[]

  @@index([taskId])
  @@index([status])
}

model WorkflowStep {
  id             String             @id @default(uuid())
  workflowRunId  String
  stepType       WorkflowStepType
  stepStatus     WorkflowStepStatus @default(PENDING)
  stepOrder      Int
  startedAt      DateTime?
  finishedAt     DateTime?
  resultMetadata Json?
  failureSummary String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  workflowRun    WorkflowRun        @relation(fields: [workflowRunId], references: [id], onDelete: Cascade)
  approvals      Approval[]

  @@index([workflowRunId])
  @@index([stepStatus])
}

model Approval {
  id             String         @id @default(uuid())
  taskId         String
  workflowStepId String?
  status         ApprovalStatus @default(PENDING)
  requestedById  String
  decidedById    String?
  reason         String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  task           Task           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  workflowStep   WorkflowStep?  @relation(fields: [workflowStepId], references: [id], onDelete: SetNull)
  requester      User           @relation("ApprovalRequester", fields: [requestedById], references: [id], onDelete: Cascade)
  decider        User?          @relation("ApprovalDecider", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([taskId])
  @@index([status])
}

model AuditEvent {
  id           String     @id @default(uuid())
  workspaceId  String?
  actorId      String?
  eventType    String
  resourceType String
  resourceId   String?
  metadata     Json?
  requestId    String?
  timestamp    DateTime   @default(now())
  // Hash chain, set on events about a VerificationRun:
  // hash = sha256(prevHash + canonical JSON of the event fields), see auditChain.ts
  prevHash     String?
  hash         String?

  workspace    Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([actorId])
  @@index([eventType])
  @@index([timestamp])
  @@index([resourceType, resourceId])
}

model OutboxEvent {
  id            String       @id @default(uuid())
  aggregateType String
  aggregateId   String
  eventType     String
  payload       Json
  status        OutboxStatus @default(PENDING)
  retryCount    Int          @default(0)
  createdAt     DateTime     @default(now())
  dispatchedAt  DateTime?

  @@index([status])
  @@index([createdAt])
}

model RepositoryAnalysis {
  id              String         @id @default(uuid())
  repositoryId    String
  workspaceId     String
  status          AnalysisStatus @default(PENDING)
  analyzerVersion String         @default("1.0.0")
  summary         Json?
  technologies    Json?
  inventory       Json?
  statistics      Json?
  errorSummary    String?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  repository      Repository     @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  workspace       Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([repositoryId])
  @@index([workspaceId])
  @@index([status])
  @@index([createdAt])
}

// ASEA verification of a change (baseSha..headSha) against a requirement.
// score and verdict stay null until scoring exists.
model VerificationRun {
  id           String                @id @default(uuid())
  workspaceId  String
  repositoryId String
  taskId       String?
  baseSha      String
  headSha      String
  requirement  String
  authorType   AuthorType
  status       VerificationRunStatus @default(QUEUED)
  score        Float?
  verdict      String?
  startedAt    DateTime?
  completedAt  DateTime?
  // Seal set when the run reaches a terminal state: the audit chain's head
  // hash and event count just before the RUN_SEALED event (see runSeal.ts)
  auditHeadHash   String?
  auditEventCount Int?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  workspace    Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  repository   Repository            @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  task         Task?                 @relation(fields: [taskId], references: [id], onDelete: SetNull)
  findings     VerificationFinding[]

  @@index([workspaceId])
  @@index([repositoryId])
  @@index([taskId])
  @@index([status])
}

// A Finding from the verification engine; findingId is the engine's Finding.id
model VerificationFinding {
  id                String          @id @default(uuid())
  verificationRunId String
  findingId         String
  category          FindingCategory
  severity          FindingSeverity
  title             String
  file              String
  line              Int
  evidence          String[]
  source            FindingSource
  ruleId            String
  remediation       String
  createdAt         DateTime        @default(now())

  verificationRun   VerificationRun @relation(fields: [verificationRunId], references: [id], onDelete: Cascade)

  @@unique([verificationRunId, findingId])
  @@index([severity])
}
