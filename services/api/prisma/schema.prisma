datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

enum WorkspaceInvitationRole {
  ADMIN
  MEMBER
}

enum RepositoryProvider {
  LOCAL
  GITHUB
}

enum RepoConnectionStatus {
  CONNECTED
  DISCONNECTED
  PENDING
}

enum VerificationRunStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum Verdict {
  ALLOW
  REVIEW
  HIGH_RISK
  BLOCK
}

enum AuthorType {
  AI
  HUMAN
  UNKNOWN
}

enum FindingCategory {
  STATIC
  NEGATIVE_SPACE
  ARCHITECTURE
  TEST_GAP
}

enum FindingSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum FindingSource {
  DETERMINISTIC
  LLM
}

enum TaskType {
  BUG_INVESTIGATION
  CODE_PATCH
  TEST_GENERATION
  CODE_REVIEW
  CI_DIAGNOSIS
  VERIFICATION
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum TaskStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCEL_REQUESTED
  CANCELLED
  NEEDS_ATTENTION
}

enum WorkflowRunStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum WorkflowStepType {
  VALIDATE_CONTEXT
  INSPECT_REPOSITORY
  GENERATE_SPEC
  GENERATE_PATCH
  APPLY_PATCH
  VERIFY_BOUNDARIES
  SIMULATE_EXECUTION
  EXECUTE_TESTS
  REQUEST_APPROVAL
  STATIC_ANALYSIS
  INDEPENDENT_REVIEW
  INDEX_REPOSITORY
  VERIFICATION_PIPELINE
}

enum WorkflowStepStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  SKIPPED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TaskPatchStatus {
  PROPOSED
  APPROVED
  REJECTED
  INVALIDATED
}

enum PatchPublicationStatus {
  NOT_PUBLISHED
  PUBLISHING
  PR_OPEN
  FAILED
}

enum PatchCiStatus {
  NOT_CONFIGURED
  PENDING
  SUCCESS
  FAILURE
  ERROR
}

enum OutboxStatus {
  PENDING
  DISPATCHED
  FAILED
}

enum AnalysisStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

model User {
  id                 String                @id @default(uuid())
  email              String                @unique
  passwordHash       String
  displayName        String
  accountStatus      AccountStatus         @default(ACTIVE)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  ownedWorkspaces    Workspace[]           @relation("WorkspaceOwner")
  memberships        WorkspaceMembership[]
  tasks              Task[]                @relation("TaskCreator")
  approvalsRequested Approval[]            @relation("ApprovalRequester")
  approvalsDecided   Approval[]            @relation("ApprovalDecider")
  createdInvitations WorkspaceInvitation[]  @relation("WorkspaceInvitationCreator")
  passwordResetTokens PasswordResetToken[]

  @@index([email])
}

model Workspace {
  id          String                @id @default(uuid())
  name        String
  ownerId     String
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  owner       User                  @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members     WorkspaceMembership[]
  repositories Repository[]
  tasks       Task[]
  auditEvents AuditEvent[]
  analyses    RepositoryAnalysis[]
  verificationRuns VerificationRun[]
  policyProfiles PolicyProfile[]
  githubAppInstallations GithubAppInstallation[]
  invitations WorkspaceInvitation[]

  @@index([ownerId])
}

model WorkspaceMembership {
  id          String        @id @default(uuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime      @default(now())

  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@index([workspaceId])
}

model WorkspaceInvitation {
  id          String        @id @default(uuid())
  workspaceId String
  email       String
  role        WorkspaceInvitationRole @default(MEMBER)
  tokenHash   String        @unique
  createdById String?
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User?      @relation("WorkspaceInvitationCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([workspaceId, email, createdAt])
  @@index([workspaceId, expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Repository {
  id               String               @id @default(uuid())
  workspaceId      String
  name             String
  provider         RepositoryProvider   @default(LOCAL)
  repositoryUrl    String
  defaultBranch    String               @default("main")
  connectionStatus RepoConnectionStatus @default(CONNECTED)
  // GitHub repository ("owner/name", lowercase) whose pull requests are
  // verified against this local checkout, and the secret its webhook signs
  // deliveries with (see routes/webhooks.ts)
  githubFullName      String?
  githubWebhookSecret String?
  githubAppInstallationId String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  workspace        Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tasks            Task[]
  analyses         RepositoryAnalysis[]
  verificationRuns VerificationRun[]
  githubAppInstallation GithubAppInstallation? @relation(fields: [githubAppInstallationId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([githubFullName])
  @@index([githubAppInstallationId])
}

// One GitHub App installation can be connected to a workspace after the
// installation callback is verified against GitHub using the App JWT.
model GithubAppInstallation {
  id             String   @id @default(uuid())
  workspaceId    String
  installationId String
  accountLogin   String
  accountType    String
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  workspace      Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  repositories   Repository[]

  @@unique([workspaceId, installationId])
  @@index([workspaceId])
}

model Task {
  id                String         @id @default(uuid())
  workspaceId       String
  repositoryId      String?
  creatorId         String
  title             String
  description       String
  taskType          TaskType       @default(BUG_INVESTIGATION)
  status            TaskStatus     @default(QUEUED)
  priority          TaskPriority   @default(NORMAL)
  repositoryUrl     String?
  targetBranch      String         @default("main")
  idempotencyKey    String?
  startedAt         DateTime?
  completedAt       DateTime?
  failureCode       String?
  failureReason     String?
  executionMetadata Json?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  workspace         Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  repository        Repository?    @relation(fields: [repositoryId], references: [id], onDelete: SetNull)
  creator           User           @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  runs              WorkflowRun[]
  verificationRuns  VerificationRun[]
  approvals         Approval[]
  patches           TaskPatch[]

  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId])
  @@index([status])
  @@index([creatorId])
}

model WorkflowRun {
  id             String            @id @default(uuid())
  taskId         String
  attemptNumber  Int               @default(1)
  status         WorkflowRunStatus @default(QUEUED)
  workerId       String?
  startedAt      DateTime?
  finishedAt     DateTime?
  errorSummary   String?
  configMetadata Json?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  task           Task              @relation(fields: [taskId], references: [id], onDelete: Cascade)
  steps          WorkflowStep[]
  patches        TaskPatch[]

  @@index([taskId])
  @@index([status])
}

model WorkflowStep {
  id             String             @id @default(uuid())
  workflowRunId  String
  stepType       WorkflowStepType
  stepStatus     WorkflowStepStatus @default(PENDING)
  stepOrder      Int
  startedAt      DateTime?
  finishedAt     DateTime?
  resultMetadata Json?
  failureSummary String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  workflowRun    WorkflowRun        @relation(fields: [workflowRunId], references: [id], onDelete: Cascade)
  approvals      Approval[]

  @@index([workflowRunId])
  @@index([stepStatus])
}

model Approval {
  id             String         @id @default(uuid())
  taskId         String
  workflowStepId String?
  // Binds a decision to the exact proposed patch; legacy approvals may be null.
  patchHash      String?
  status         ApprovalStatus @default(PENDING)
  requestedById  String
  decidedById    String?
  reason         String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  task           Task           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  workflowStep   WorkflowStep?  @relation(fields: [workflowStepId], references: [id], onDelete: SetNull)
  requester      User           @relation("ApprovalRequester", fields: [requestedById], references: [id], onDelete: Cascade)
  decider        User?          @relation("ApprovalDecider", fields: [decidedById], references: [id], onDelete: SetNull)

  @@unique([taskId, patchHash])
  @@index([taskId])
  @@index([status])
}

// A reviewable patch artifact is bound to the task's isolated source snapshot.
// The task workspace itself is disposable and its path is intentionally not persisted.
model TaskPatch {
  id                     String          @id @default(uuid())
  taskId                 String
  workflowRunId          String
  snapshotHash           String
  sourceRevision         String?
  patchHash              String
  summary                String
  plan                   Json
  evidence               Json?
  contextFiles           Json
  changedFiles           Json
  baseFiles              Json              @default("[]")
  unifiedDiff            String          @db.Text
  testStatus             String          @default("NOT_RUN")
  securityStatus         String          @default("NOT_RUN")
  reviewStatus           String          @default("UNAVAILABLE")
  testResults            Json?
  securityResults        Json?
  reviewResults          Json?
  sandboxDiagnostics     Json?
  workspaceCleanupStatus String          @default("CLEANED")
  status                 TaskPatchStatus @default(PROPOSED)
  publicationStatus      PatchPublicationStatus @default(NOT_PUBLISHED)
  publicationError       String?
  publishedBranch        String?
  githubCommitSha        String?
  pullRequestNumber      Int?
  pullRequestUrl         String?
  publishedAt            DateTime?
  ciStatus               PatchCiStatus @default(NOT_CONFIGURED)
  ciChecks               Json?
  ciDiagnosis            Json?
  ciSyncedAt             DateTime?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  task                   Task            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  workflowRun            WorkflowRun     @relation(fields: [workflowRunId], references: [id], onDelete: Cascade)

  @@unique([taskId, patchHash])
  @@unique([workflowRunId])
  @@index([taskId])
  @@index([status])
}

model AuditEvent {
  id           String     @id @default(uuid())
  workspaceId  String?
  actorId      String?
  eventType    String
  resourceType String
  resourceId   String?
  metadata     Json?
  requestId    String?
  timestamp    DateTime   @default(now())
  // Hash chain, set on events about a VerificationRun:
  // hash = sha256(prevHash + canonical JSON of the event fields), see auditChain.ts
  prevHash     String?
  hash         String?

  workspace    Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([actorId])
  @@index([eventType])
  @@index([timestamp])
  @@index([resourceType, resourceId])
}

model OutboxEvent {
  id            String       @id @default(uuid())
  aggregateType String
  aggregateId   String
  eventType     String
  payload       Json
  status        OutboxStatus @default(PENDING)
  retryCount    Int          @default(0)
  createdAt     DateTime     @default(now())
  dispatchedAt  DateTime?

  @@index([status])
  @@index([createdAt])
}

model RepositoryAnalysis {
  id              String         @id @default(uuid())
  repositoryId    String
  workspaceId     String
  status          AnalysisStatus @default(PENDING)
  analyzerVersion String         @default("1.0.0")
  summary         Json?
  technologies    Json?
  inventory       Json?
  statistics      Json?
  errorSummary    String?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  repository      Repository     @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  workspace       Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([repositoryId])
  @@index([workspaceId])
  @@index([status])
  @@index([createdAt])
}

// How a workspace turns findings into a score and verdict. config is a
// PolicyConfig document (packages/contracts/src/policy.ts); configHash is the
// sha256 of its canonical JSON. Each workspace has exactly one default profile
// (enforced by policyService.ts).
model PolicyProfile {
  id          String   @id @default(uuid())
  workspaceId String
  name        String
  description String?
  config      Json
  configHash  String
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace        Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  verificationRuns VerificationRun[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

// ASEA verification of a change (baseSha..headSha) against a requirement.
// score, verdict and scoreBreakdown are null until the run has been scored.
model VerificationRun {
  id           String                @id @default(uuid())
  workspaceId  String
  repositoryId String
  taskId       String?
  baseSha      String
  headSha      String
  requirement  String
  authorType   AuthorType
  status       VerificationRunStatus @default(QUEUED)
  score        Float?
  verdict      Verdict?
  // The engine's ScoreResult ("why this score")
  scoreBreakdown Json?
  // Policy chosen at submission; the run keeps a snapshot of its config and
  // the config's hash, so later edits to the profile don't change the run
  policyProfileId String?
  policyHash      String?
  policySnapshot  Json?
  // Pipeline progress, updated live while the run executes: one entry per
  // agent (ingest, static, negative_space, architecture, score, report)
  agentTimeline Json?
  // The reporter's summary and per-finding explanations
  report        Json?
  // LLM provider/model, static tools and whether every agent completed
  engineInfo    Json?
  // Set when a GitHub pull request triggered the run: repository, number,
  // URL, delivery id, and the outcome of posting the result as a PR comment
  github        Json?
  startedAt    DateTime?
  completedAt  DateTime?
  // Seal set when the run reaches a terminal state: the audit chain's head
  // hash and event count just before the RUN_SEALED event (see runSeal.ts)
  auditHeadHash   String?
  auditEventCount Int?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  workspace    Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  repository   Repository            @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  task         Task?                 @relation(fields: [taskId], references: [id], onDelete: SetNull)
  policyProfile PolicyProfile?       @relation(fields: [policyProfileId], references: [id], onDelete: SetNull)
  findings     VerificationFinding[]

  @@index([workspaceId])
  @@index([repositoryId])
  @@index([taskId])
  @@index([status])
  @@index([policyProfileId])
}

// A Finding from the verification engine; findingId is the engine's Finding.id
model VerificationFinding {
  id                String          @id @default(uuid())
  verificationRunId String
  findingId         String
  category          FindingCategory
  severity          FindingSeverity
  title             String
  file              String
  line              Int
  evidence          String[]
  source            FindingSource
  ruleId            String
  remediation       String
  createdAt         DateTime        @default(now())

  verificationRun   VerificationRun @relation(fields: [verificationRunId], references: [id], onDelete: Cascade)

  @@unique([verificationRunId, findingId])
  @@index([severity])
}
