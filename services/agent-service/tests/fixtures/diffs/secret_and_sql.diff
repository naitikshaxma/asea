+
+
+def search_projects(owner_id, term):
+    with get_connection() as conn:
+        cursor = conn.cursor()
+        cursor.execute(
+            f"SELECT id, name FROM projects WHERE owner_id = {owner_id} AND name LIKE '%{term}%'"
+        )
+        return [{"id": row[0], "name": row[1]} for row in cursor.fetchall()]
