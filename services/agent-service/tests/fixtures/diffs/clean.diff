+
+
+def rename_project(owner_id, project_id, name):
+    with get_connection() as conn:
+        cursor = conn.cursor()
+        cursor.execute(
+            "UPDATE projects SET name = ? WHERE id = ? AND owner_id = ?",
+            (name, project_id, owner_id),
+        )
+        return {"id": project_id, "name": name}
