{
  "name": "autonomous-engineer-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Monorepo for the Autonomous AI Software Engineering Platform",
  "workspaces": [
    "packages/*",
    "services/api",
    "apps/*",
    "e2e"
  ],
  "scripts": {
    "dev": "concurrently -n \"api,web\" -c \"blue,magenta\" \"npm run dev:api\" \"npm run dev:web\"",
    "dev:all": "concurrently -n \"api,worker,web\" -c \"blue,yellow,magenta\" \"npm run dev:api\" \"npm run dev:worker\" \"npm run dev:web\"",
    "dev:api": "npm run dev --workspace=@autonomous-engineer/api",
    "dev:worker": "npm run dev:worker --workspace=@autonomous-engineer/api",
    "dev:web": "npm run dev --workspace=@autonomous-engineer/web",
    "dev:agent": "python -m uvicorn app.main:app --app-dir services/agent-service --port 8000 --reload",
    "prisma:generate": "npm run prisma:generate --workspace=@autonomous-engineer/api",
    "prisma:migrate": "npm run prisma:migrate --workspace=@autonomous-engineer/api",
    "build": "npm run build:contracts && npm run build:api && npm run build:web",
    "build:contracts": "npm run build --workspace=@autonomous-engineer/contracts",
    "build:api": "npm run build --workspace=@autonomous-engineer/api",
    "build:web": "npm run build --workspace=@autonomous-engineer/web",
    "test": "npm run test:api && npm run test:web",
    "test:api": "npm run test --workspace=@autonomous-engineer/api",
    "test:web": "npm run test --workspace=@autonomous-engineer/web",
    "test:python": "node scripts/run-python-tests.js",
    "semgrep:rules": "node scripts/run-python.js services/agent-service/scripts/fetch_semgrep_rules.py",
    "test:all": "npm run test && npm run test:python",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run typecheck",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "stack:up": "node scripts/stack/stack.mjs up",
    "stack:down": "node scripts/stack/stack.mjs down",
    "stack:logs": "node scripts/stack/stack.mjs logs",
    "e2e": "node scripts/e2e/run.mjs",
    "clean": "npm run clean --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.3"
  }
}
